{
  "manifest_version": 3,
  "name": "Page Asset Grabber",
  "version": "1.1.0",
  "description": "Find and bulk-save JPG, PNG and GIF assets, including legacy pages, frames and CSS.",
  "permissions": ["downloads", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Page Asset Grabber", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": { "scan-page": { "suggested_key": { "default": "Ctrl+Shift+Y" }, "description": "Scan the current page" } }
}
